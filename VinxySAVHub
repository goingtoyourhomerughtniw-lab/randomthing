local function applyFPSBoost(enable)
    if enable then
        Lighting.Sky = nil
        local blackSky = Instance.new("Sky")
        blackSky.SkyboxBk = "rbxassetid://600830446"
        blackSky.SkyboxDn = "rbxassetid://600830446"
        blackSky.SkyboxFt = "rbxassetid://600830446"
        blackSky.SkyboxLf = "rbxassetid://600830446"
        blackSky.SkyboxRt = "rbxassetid://600830446"
        blackSky.SkyboxUp = "rbxassetid://600830446"
        blackSky.Parent = Lighting
        Lighting.Ambient = Color3.fromRGB(0,0,0)
        Lighting.Brightness = 0.3
        Lighting.GlobalShadows = false
    else
        Lighting.GlobalShadows = true
        Lighting.Brightness = 1
        Lighting.Ambient = Color3.fromRGB(0.5,0.5,0.5)
    end
end


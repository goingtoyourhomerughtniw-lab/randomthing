-- Keybinds
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then speedEnabled = not speedEnabled; notify("Speed: "..(speedEnabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.G then jumpEnabled = not jumpEnabled; notify("Jump: "..(jumpEnabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.H then hitboxEnabled = not hitboxEnabled; notify("Hitbox: "..(hitboxEnabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.B then fpsBoostEnabled = not fpsBoostEnabled; notify("FPS Booster: "..(fpsBoostEnabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.R then antiRagdollEnabled = not antiRagdollEnabled; notify("Anti Ragdoll: "..(antiRagdollEnabled and "ON" or "OFF"))
    end
end)

